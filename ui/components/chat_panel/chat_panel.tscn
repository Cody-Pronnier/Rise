[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/components/chat_panel/chat_panel.gd" id="1_script"]

[node name="ChatPanel" type="VBoxContainer"]
theme_override_constants/separation = 10
script = ExtResource("1_script")

[node name="ChatTitle" type="Label" parent="."]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.7, 0.4, 1)
theme_override_font_sizes/font_size = 20
text = "Discussion"

[node name="ChatLog" type="RichTextLabel" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/normal_font_size = 15
scroll_following = true
selection_enabled = true

[node name="InputRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="MessageInput" type="LineEdit" parent="InputRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Écrire un message…"

[node name="SendButton" type="Button" parent="InputRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(110, 0)
layout_mode = 2
focus_mode = 0
text = "Envoyer"
